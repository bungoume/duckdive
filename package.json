{
  "name": "duckdive",
  "private": true,
  "version": "0.2.0",
  "description": "Search and visualize log files from S3, HTTPS URLs or local disk, in the browser",
  "license": "MIT",
  "homepage": "https://github.com/bungoume/duckdive",
  "repository": {
    "type": "git",
    "url": "https://github.com/bungoume/duckdive.git"
  },
  "bugs": {
    "url": "https://github.com/bungoume/duckdive/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.0+sha512.37536c26ed40ab4134b6511e09f6b27f3ebb45687468f2406ca3805279a4e5ca158c1931350ad9774d6ab2108d71b3dbaeb39943159294375e4d053e8e05685c",
  "scripts": {
    "prepare:assets": "node scripts/prepare-duckdb.mjs && node scripts/third-party-licenses.mjs",
    "icons": "node scripts/make-icons.mjs",
    "prebuild": "pnpm run prepare:assets",
    "build": "tsc --noEmit && vite build",
    "dev": "pnpm run prepare:assets && VITE_DDV_DEBUG=1 vite build --watch",
    "build:e2e": "VITE_DDV_DEBUG=1 DDV_EXTRA_HOSTS=\"http://localhost/*\" pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pack": "node scripts/pack.mjs",
    "test:unit": "vitest run",
    "test:e2e": "node e2e/smoke.mjs",
    "test:cache": "node e2e/cache.mjs",
    "screenshots": "node e2e/screenshots.mjs",
    "test": "pnpm run typecheck && pnpm run lint && pnpm run test:unit && pnpm run build:e2e && node e2e/smoke.mjs && node e2e/cache.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@observablehq/plot": "0.6.17",
    "pako": "3.0.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@types/chrome": "0.2.9",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
