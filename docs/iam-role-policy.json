{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLogs",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::my-logs/logs/*"]
    },
    {
      "Sid": "ListForGlobs",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::my-logs"],
      "Condition": { "StringLike": { "s3:prefix": ["logs/*"] } }
    }
  ]
}
